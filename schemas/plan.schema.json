{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zj-initiative-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "initiativeId", "specId", "label", "path", "engine"],
  "properties": {
    "$schema": { "const": "zj-initiative-plan/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "initiativeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "specId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^docs/plans/[^/].*\\.json$" },
    "engine": { "const": "zj-roadmap-driven" }
  }
}
