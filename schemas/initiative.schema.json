{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zj-initiative/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "label", "kind", "lifecycle", "repository", "defaultBranch", "owner"],
  "properties": {
    "$schema": { "const": "zj-initiative/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["product", "shared-capability", "experimental", "external"] },
    "lifecycle": { "enum": ["active", "dormant", "archived"] },
    "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 }
  }
}
